{
  "schema_version": 1,
  "release": "v0.3.1",
  "purpose": "Make one-read external clarity a blocking public-release condition rather than a decorative style claim.",
  "forbidden_phrases": [
    "Style check: external style applied",
    "game-changer",
    "paradigm shift",
    "leveraging AI",
    "harnessing the power",
    "it is important to note",
    "in today's rapidly"
  ],
  "dense_terms": [
    "canonical",
    "bounded retrieval",
    "relationship-aware retrieval",
    "source provenance",
    "task-time controls",
    "candidate enforcement",
    "candidate output",
    "derived index",
    "causal spine"
  ],
  "surfaces": [
